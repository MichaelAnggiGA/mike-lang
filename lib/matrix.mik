start module; matrix
    # ============================================================
    #  lib matrix — dense matrices stored as flat arrays (row-major).
    #  A matrix is (array, rows, cols) with element (i,j) at i*cols + j.
    #  Use array(rows*cols) to allocate.
    # ============================================================

    # element access: get m[i][j]
    func mget(m, cols, i, j)
        var idx = i * cols + j
        return m[idx]
    end func

    # element set: m[i][j] = v   (returns v)
    func mset(m, cols, i, j, v)
        var idx = i * cols + j
        m[idx] = v
        return v
    end func

    # fill an r x c matrix with a constant
    func mfill(m, r, c, val)
        var n = r * c
        for k = 0 to n - 1
            m[k] = val
        end for
        return 0
    end func

    # identity into an n x n matrix
    func identity(m, n)
        mfill(m, n, n, 0.0)
        for i = 0 to n - 1
            mset(m, n, i, i, 1.0)
        end for
        return 0
    end func

    # transpose A (ra x ca) into B (ca x ra)
    func transpose(a, ra, ca, b)
        for i = 0 to ra - 1
            for j = 0 to ca - 1
                var v = mget(a, ca, i, j)
                mset(b, ra, j, i, v)
            end for
        end for
        return 0
    end func

    # matrix multiply: A(ra x ca) * B(ca x cb) -> C(ra x cb)
    func matmul(a, ra, ca, b, cb, c)
        for i = 0 to ra - 1
            for j = 0 to cb - 1
                var s = 0.0
                for k = 0 to ca - 1
                    s = s + mget(a, ca, i, k) * mget(b, cb, k, j)
                end for
                mset(c, cb, i, j, s)
            end for
        end for
        return 0
    end func

    # matrix-vector product: A(ra x ca) * v(ca) -> out(ra)
    func matvec(a, ra, ca, v, out)
        for i = 0 to ra - 1
            var s = 0.0
            for k = 0 to ca - 1
                s = s + mget(a, ca, i, k) * v[k]
            end for
            out[i] = s
        end for
        return 0
    end func

    # trace of an n x n matrix
    func trace(m, n)
        var s = 0.0
        for i = 0 to n - 1
            s = s + mget(m, n, i, i)
        end for
        return s
    end func

    # determinant of a 2x2 matrix
    func det2(m)
        return m[0] * m[3] - m[1] * m[2]
    end func

    # determinant of a 3x3 matrix (Sarrus)
    func det3(m)
        var a = m[0]
        var b = m[1]
        var c = m[2]
        var d = m[3]
        var e = m[4]
        var f = m[5]
        var g = m[6]
        var h = m[7]
        var i = m[8]
        return a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)
    end func
end modul
