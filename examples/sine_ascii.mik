start module; sine_ascii
    lib input/output
    lib plot

    func main()
        var n = 40
        var xs = array(n)
        var ys = array(n)
        for i = 0 to n - 1
            var x = i / 4.0
            xs[i] = x
            ys[i] = sin(x)
        end for

        print "=== Grafik sin(x) di terminal ==="
        plot_show(xs, ys, n, 0.0, 10.0, -1.0, 1.0)
        return 0
    end func
end modul
