start module; usefinance
    lib input/output
    lib finance

    func main()
        print "=== Time Value of Money ==="
        # $10,000 in 5 years at 6% -> PV should be ~7472.58
        print "PV of 10000 in 5yr @6%:"
        print pv_lump(10000.0, 0.06, 5.0)

        # $5000 today at 7% for 20 years -> FV
        print "FV of 5000 @7% for 20yr:"
        print fv_lump(5000.0, 0.07, 20.0)

        print "=== Loan Payment (PMT) ==="
        # $200,000 mortgage, 5%/yr monthly, 30yr -> ~-1073.64
        print "Monthly pmt 200k @5% 30yr:"
        print pmt(200000.0, per_period(0.05, 12.0), 360.0, 0.0, 0.0)

        print "=== NPV / IRR ==="
        var cf = array(5)
        cf[0] = -5000.0
        cf[1] = 1500.0
        cf[2] = 2000.0
        cf[3] = 2500.0
        cf[4] = 3000.0
        print "NPV @10%:"
        print npv(0.10, cf, 5)
        print "IRR:"
        print irr(cf, 5, -0.5, 1.0, 60.0)

        print "=== Interest conversions ==="
        print "EAR of 12% nominal, monthly:"
        print ear(0.12, 12.0)

        print "=== CAGR ==="
        # 100 -> 800 over 15 years -> ~14.9%
        print "CAGR 100->800 over 15yr:"
        print cagr(100.0, 800.0, 15.0)

        print "=== Bond ==="
        # 10yr, 5% coupon, 5.7% ytm, annual -> price < 1000 (discount)
        print "Bond price:"
        print bond_price(1000.0, 0.05, 0.057, 10.0, 1.0)

        print "=== Depreciation ==="
        print "Straight-line (11000,1000,10yr):"
        print dep_straight(11000.0, 1000.0, 10.0)
        print "Double-declining yr1:"
        print dep_declining(11000.0, 1000.0, 10.0, 2.0, 1.0)
        return 0
    end func
end modul
