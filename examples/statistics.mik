start module; statistics
    lib input/output

    # ============================================================
    #  A statistics + Monte Carlo toolkit, written entirely in Mike.
    #  Demonstrates: floats, arrays, math builtins, RNG, functions.
    # ============================================================

    # ---- descriptive statistics ----

    func mean(a, n)
        var s = 0.0
        for i = 0 to n - 1
            s = s + a[i]
        end for
        return s / n
    end func

    func variance(a, n)
        var m = mean(a, n)
        var s = 0.0
        for i = 0 to n - 1
            var d = a[i] - m
            s = s + d * d
        end for
        return s / n
    end func

    func stdev(a, n)
        return sqrt(variance(a, n))
    end func

    func amin(a, n)
        var m = a[0]
        for i = 1 to n - 1
            if a[i] < m
                m = a[i]
            end if
        end for
        return m
    end func

    func amax(a, n)
        var m = a[0]
        for i = 1 to n - 1
            if a[i] > m
                m = a[i]
            end if
        end for
        return m
    end func

    # ---- sorting + percentiles ----

    func sort(a, n)
        for i = 1 to n - 1
            var key = a[i]
            var j = i - 1
            while j >= 0 and a[j] > key
                a[j + 1] = a[j]
                j = j - 1
            end while
            a[j + 1] = key
        end for
        return 0
    end func

    func percentile(a, n, p)
        var idx = p * (n - 1)
        var lo = floor(idx)
        var frac = idx - lo
        var i = lo
        return a[i] + frac * (a[i + 1] - a[i])
    end func

    # ---- a small correlation example ----

    func correlation(x, y, n)
        var mx = mean(x, n)
        var my = mean(y, n)
        var sxy = 0.0
        var sxx = 0.0
        var syy = 0.0
        for i = 0 to n - 1
            var dx = x[i] - mx
            var dy = y[i] - my
            sxy = sxy + dx * dy
            sxx = sxx + dx * dx
            syy = syy + dy * dy
        end for
        return sxy / sqrt(sxx * syy)
    end func

    func main()
        seed(31415)
        var n = 2000

        # sample from Normal(mu=100, sd=15)
        var data = array(n)
        for i = 0 to n - 1
            data[i] = gauss(100.0, 15.0)
        end for

        print "=== Descriptive statistics (Normal 100, 15) ==="
        print "n:"
        print n
        print "mean:"
        print mean(data, n)
        print "stdev:"
        print stdev(data, n)
        print "min:"
        print amin(data, n)
        print "max:"
        print amax(data, n)

        sort(data, n)
        print "P10:"
        print percentile(data, n, 0.10)
        print "P50 (median):"
        print percentile(data, n, 0.50)
        print "P90:"
        print percentile(data, n, 0.90)

        # correlation: y = 2x + noise should give r ~ 1
        var x = array(n)
        var y = array(n)
        for i = 0 to n - 1
            x[i] = rand_range(0.0, 10.0)
            y[i] = 2.0 * x[i] + gauss(0.0, 1.0)
        end for
        print "=== Correlation (y = 2x + noise) ==="
        print "r:"
        print correlation(x, y, n)

        return 0
    end func
end modul
